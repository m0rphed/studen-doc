<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" class="in-text" version="1.0" default-locale="ru-RU" page-range-format="expanded">
  <info>
    <title>ГОСТ 7.32-2017, список использованных источников (нумерованный)</title>
    <title-short>ГОСТ 7.32-2017</title-short>
    <id>http://example.org/csl/gost-7-32-2017-numeric</id>
    <author>
      <name>studen-doc</name>
    </author>
    <category citation-format="numeric"/>
    <category field="generic-base"/>
    <summary>Библиографические описания по примерам ГОСТ 7.32-2017 (приложения Д и Е) и ГОСТ 7.1-2003. Ссылки в тексте - номер в квадратных скобках (6.9.1), записи списка нумеруются арабскими цифрами с точкой (6.16). Блоки описания разделяются знаком " - " (длинное тире), диапазоны страниц и лет пишутся длинным тире, как в примерах стандарта. Структура описания и макросы выведены из gost-r-7-0-5-2008-numeric (Yurkin Maxim).</summary>
    <updated>2026-10-21T00:00:00+00:00</updated>
    <rights license="http://creativecommons.org/licenses/by-sa/3.0/">This work is licensed under a Creative Commons Attribution-ShareAlike 3.0 License</rights>
  </info>
  <!-- Термины. Описание всегда русское: язык отдельной записи CSL выбрать не позволяет. -->
  <locale xml:lang="ru">
    <terms>
      <term name="accessed">дата обращения</term>
      <term name="online">электронный ресурс</term>
      <term name="et-al">и др.</term>
      <term name="editor" form="verb-short">под ред.</term>
      <term name="translator" form="verb-short">пер.</term>
      <term name="page-range-delimiter">—</term>
      <term name="ordinal">-е</term>
      <term name="issue" form="symbol">№</term>
    </terms>
  </locale>
  <!-- Заголовок записи: автор(ы), от одного до трех - полностью, четыре и более - первые три и "и др." -->
  <macro name="heading">
    <names variable="author" suffix=".">
      <name name-as-sort-order="all" sort-separator=" " initialize-with=". " delimiter=", " delimiter-precedes-last="always" delimiter-precedes-et-al="never" et-al-min="4" et-al-use-first="3"/>
      <et-al term="et-al"/>
    </names>
  </macro>
  <!-- Основное заглавие и общее обозначение материала в квадратных скобках ([Электронный ресурс], [Рецензия]). -->
  <macro name="title">
    <group delimiter=" ">
      <text variable="title"/>
      <text variable="medium" prefix="[" suffix="]"/>
    </group>
  </macro>
  <!-- Составная часть: заглавие документа, в котором она опубликована, после "//". -->
  <macro name="container">
    <text variable="container-title" prefix=" // "/>
  </macro>
  <!-- Сведения об ответственности издания: редакторы и переводчики после "/". -->
  <macro name="responsibility">
    <names variable="editor translator" delimiter="; " prefix=" / ">
      <label form="verb-short" suffix=" "/>
      <name initialize-with=". " delimiter=", " delimiter-precedes-last="always"/>
    </names>
  </macro>
  <!-- Издание: число (edition = 3, как в BibLaTeX) превращается в "3-е изд."; текст ("3-е изд., перераб. и доп.")
       выводится как есть. Известное расхождение движков: для строки, начинающейся с цифры, citeproc-js (Zotero,
       Word) считает ее числом и портит запись, pandoc - нет; в pandoc (библиотека studen-doc) работает все. -->
  <macro name="edition">
    <choose>
      <if is-numeric="edition">
        <group delimiter=" ">
          <number variable="edition" form="ordinal"/>
          <text term="edition" form="short"/>
        </group>
      </if>
      <else>
        <text variable="edition"/>
      </else>
    </choose>
  </macro>
  <!-- Выходные данные: место: издательство, год. -->
  <macro name="imprint">
    <group delimiter=", ">
      <group delimiter=": ">
        <text variable="publisher-place"/>
        <text variable="publisher"/>
      </group>
      <date variable="issued">
        <date-part name="year" range-delimiter="—"/>
      </date>
    </group>
  </macro>
  <macro name="volume-issue">
    <group delimiter=", ">
      <group delimiter=" ">
        <text term="volume" form="short" text-case="capitalize-first"/>
        <text variable="volume"/>
      </group>
      <group delimiter=" ">
        <text term="issue" form="symbol"/>
        <text variable="issue"/>
      </group>
    </group>
  </macro>
  <!-- Объем: страницы составной части ("С. 8-19") либо число страниц документа ("351 с."). -->
  <macro name="extent">
    <choose>
      <if variable="page">
        <group delimiter=" ">
          <label variable="page" form="short" text-case="capitalize-first" plural="never"/>
          <text variable="page"/>
        </group>
      </if>
      <else>
        <group delimiter=" ">
          <text variable="number-of-pages"/>
          <text term="page" form="short"/>
        </group>
      </else>
    </choose>
  </macro>
  <macro name="series">
    <group delimiter=" ; " prefix="(" suffix=")">
      <text variable="collection-title"/>
      <text variable="collection-number"/>
    </group>
  </macro>
  <macro name="access">
    <group delimiter=" ">
      <text variable="URL" prefix="URL: "/>
      <group prefix="(" suffix=")" delimiter=": ">
        <text term="accessed"/>
        <date variable="accessed">
          <date-part name="day" suffix="." form="numeric-leading-zeros"/>
          <date-part name="month" suffix="." form="numeric-leading-zeros"/>
          <date-part name="year"/>
        </date>
      </group>
    </group>
  </macro>
  <citation collapse="citation-number">
    <sort>
      <key variable="citation-number"/>
    </sort>
    <layout prefix="[" suffix="]" delimiter=", ">
      <text variable="citation-number"/>
      <group prefix=", " delimiter=" ">
        <label variable="locator" form="short" plural="never"/>
        <text variable="locator"/>
      </group>
    </layout>
  </citation>
  <bibliography et-al-min="4" et-al-use-first="3" entry-spacing="0" second-field-align="flush">
    <layout suffix=".">
      <text variable="citation-number" suffix=". "/>
      <group delimiter=". — ">
        <group delimiter=" ">
          <text macro="heading"/>
          <group>
            <text macro="title"/>
            <text macro="container"/>
            <text macro="responsibility"/>
          </group>
        </group>
        <text macro="edition"/>
        <text macro="imprint"/>
        <text macro="volume-issue"/>
        <text macro="extent"/>
        <text macro="series"/>
        <text macro="access"/>
      </group>
    </layout>
  </bibliography>
</style>
